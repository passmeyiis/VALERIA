<!DOCTYPE html>
<html lang="id" data-theme="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Reset Password — Valeria</title>
  <link rel="stylesheet" href="{{ url_for('static', filename='css/style.css') }}">
</head>
<body class="login-shell">
  <div class="login-card" style="max-width: 500px; min-height: auto;">
    <div class="login-form-side" style="width: 100%; flex: 1; padding: 40px;">
      <h2>Reset Password</h2>
      <p class="lead">Masukkan kode verifikasi yang dikirim ke email lu dan buat password baru.</p>

      {% with messages = get_flashed_messages(with_categories=true) %}
        {% if messages %}
          {% for category, message in messages %}
            <div class="alert alert-{{ 'success' if category == 'success' else 'danger' }}">
              <span>{{ message }}</span>
            </div>
          {% endfor %}
        {% endif %}
      {% endwith %}

      <form action="{{ url_for('reset_password') }}" method="POST">
        <div class="field">
          <label for="token">Kode Verifikasi / Referral</label>
          <input type="text" id="token" name="token" placeholder="Contoh: VAL-9821" required>
        </div>
        <div class="field">
          <label for="new_password">Password Baru</label>
          <input type="password" id="new_password" name="new_password" placeholder="••••••••" required>
        </div>
        <button type="submit" class="btn btn-primary btn-block">Ubah Password</button>
      </form>

      <div style="text-align: center; margin-top: 20px;">
        <a href="{{ url_for('login') }}" style="color: var(--primary); font-size: 13px; font-weight: 600;">← Kembali ke Login</a>
      </div>
    </div>
  </div>
</body>
</html>